{
  "name": "attendant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:db": "node --test \"tests/db/**/*.test.ts\"",
    "db:types": "node scripts/generate-database-types.ts",
    "db:types:check": "node scripts/generate-database-types.ts --check",
    "db:migrate": "node scripts/apply-migrations.ts",
    "db:migrate:status": "node scripts/apply-migrations.ts --status",
    "admin:create": "node scripts/create-super-admin.ts",
    "admin:password": "node scripts/set-account-password.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "date-fns": "^4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5"
  }
}
