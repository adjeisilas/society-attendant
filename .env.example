# Supabase project URL and publishable (anon) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (service role) key — server only. Never prefix with NEXT_PUBLIC_.
# Used exclusively for Auth admin operations (inviting and disabling users).
SUPABASE_SECRET_KEY=
# Postgres connection for `npm run db:migrate` — session pooler (port 5432), never the transaction pooler (6543).
# Supabase dashboard → Connect → Session pooler. Local/CI only; the app never reads it.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
